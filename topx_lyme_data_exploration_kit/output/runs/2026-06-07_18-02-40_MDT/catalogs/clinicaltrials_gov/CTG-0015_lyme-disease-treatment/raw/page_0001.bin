G002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"0","lowerLimit":"0","upperLimit":"0"}]}]},{"title":"Day 14","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"1"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG001","value":"20","lowerLimit":"20","upperLimit":"20"}]}]},{"title":"Day 21","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"1"},{"groupId":"OG001","value":"0"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"0","lowerLimit":"0","upperLimit":"0"}]}]},{"title":"Day 28","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"1"},{"groupId":"OG001","value":"0"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"0","lowerLimit":"0","upperLimit":"0"}]}]},{"title":"Day 60","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}]}]},{"type":"PRIMARY","title":"Joint Redness Reported by Serial Visual Analog Scale for Joint Redness Via Text Surveys","description":"0-100 scale (no redness to maximal redness- higher score, worse outcome), slide bar in text survey","populationDescription":"There was not 100% follow-up with text surveys","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Full Range","unitOfMeasure":"score on a scale","timeFrame":"days 0 (enrollment), 1, 3, 7, 10, 14, 21, 28, 60 the VAS score for join redness will be collected","groups":[{"id":"OG000","title":"NSAID","description":"Naproxen at weight based standard dose given bid daily until symptoms resolve\n\nNaproxen: Patients will be randomized to an NSAID (naproxen)"},{"id":"OG001","title":"Acetaminophen",