alt Lake City","city":"West Jordan","state":"Utah","zip":"84088","country":"United States","geoPoint":{"lat":40.60967,"lon":-111.9391}},{"facility":"Pediatric Research of Charlottesville, LLC","city":"Charlottesville","state":"Virginia","zip":"22902","country":"United States","geoPoint":{"lat":38.02931,"lon":-78.47668}},{"facility":"Clinical Research Partners, LLC","city":"Richmond","state":"Virginia","zip":"23226","country":"United States","geoPoint":{"lat":37.55376,"lon":-77.46026}},{"facility":"Frontier Clinical research","city":"Kingwood","state":"West Virginia","zip":"26537","country":"United States","geoPoint":{"lat":39.47176,"lon":-79.68339}},{"facility":"Preston Healthcare Services","city":"Kingwood","state":"West Virginia","zip":"26537","country":"United States","geoPoint":{"lat":39.47176,"lon":-79.68339}}]},"referencesModule":{"seeAlsoLinks":[{"label":"To obtain contact information for a study center near you, click here.","url":"https://pmiform.com/clinical-trial-info-request?StudyID=C4601012"}]},"ipdSharingStatementModule":{"ipdSharing":"YES","description":"Pfizer will provide access to individual de-identified participant data and related study documents (e.g. protocol, Statistical Analysis Plan (SAP), Clinical Study Report (CSR)) upon request from qualified researchers, and subject to certain criteria, conditions, and exceptions. Further details on Pfizer's data sharing criteria and process for requesting access can be found at: https://www.pfizer.com/science/clinical\\_trials/trial\\_data\\_and\\_results/data\\_requests.","url":"https://www.pfizer.com/science/clinical_trials/trial_data_and_results/data_requests"}},"resultsSection":{"participantFlowModule":{"preAssignmentDetails":"This study was conducted across 57 sites across the United States of America (USA).","recruitmentDetails":"A total of 3646 participants were enrolled, of which 3547 participants were randomized.","groups":[{"id":"FG000","title":"VLA15: 5 to 11 Years","description":"Participan