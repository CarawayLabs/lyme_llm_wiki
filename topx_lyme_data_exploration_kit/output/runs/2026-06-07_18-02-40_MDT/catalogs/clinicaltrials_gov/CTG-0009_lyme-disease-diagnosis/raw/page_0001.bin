","value":"66.8","spread":"31.4"},{"groupId":"OG001","value":"44.3","spread":"22.9"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"0.92","statisticalMethod":"ANOVA"},{"groupIds":["OG000"],"nonInferiorityType":"SUPERIORITY","pValue":"0.053","statisticalMethod":"t-test, 2 sided"},{"groupIds":["OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"0.069","statisticalMethod":"t-test, 2 sided"}]},{"type":"SECONDARY","title":"Brief Pain Inventory-Pain 24 Hours","description":"This 15-item questionnaire assesses the location, severity, and type of current pain, using analogue scales and body diagrams. Subscale-pain 24 hours describes the pain at its worst in the past 24 hours.\n\nMinimum value:0 Maximum value: 10 The higher scores means higher pain level","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Standard Deviation","unitOfMeasure":"score on a scale","timeFrame":"Before treatment (baseline) and Post treatment (at the end of 2-week treatment)","groups":[{"id":"OG000","title":"RAVANS","description":"active RAVANS, 20 minutes each treatment, 3 times per week for 2 weeks\n\nrespiratory-gated auricular vagal afferent nerve stimulation (RAVANS): non-painful electrical stimulation of the auricle"},{"id":"OG001","title":"Sham Stimulation","description":"Sham-stimulation, 20 minutes each treatment, 3 times per week for 2 weeks\n\nSham RAVANS: sham stimulation"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"8"},{"groupId":"OG001","value":"7"}]}],"classes":[{"title":"Before Treatment","categories":[{"measurements":[{"groupId":"OG000","value":"5.6","spread":"2.1"},{"groupId":"OG001","value":"6.4","spread":"2.2"}]}]},{"title":"Post Treatment","categories":[{"measurements":[{"groupId":"OG000","value":"4.8","spread":"3.3"},{"groupId":"OG001","value":"4.4","spread":"2.9"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"0.35","statisticalMethod":"ANOVA"}