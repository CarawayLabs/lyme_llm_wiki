le":"Day 1","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"1"},{"groupId":"OG001","value":"2"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"1"}]}]},{"title":"Day 3","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"1"},{"groupId":"OG001","value":"1"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"0"}]}]},{"title":"Day 7","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"1"},{"groupId":"OG001","value":"0"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"0"}]}]},{"title":"Day 10","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"1"},{"groupId":"OG001","value":"0"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"0"}]}]},{"title":"Day 14","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"0"},{"groupId":"OG001","value":"1"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG001","value":"0"}]}]},{"title":"Day 21","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"1"},{"groupId":"OG001","value":"0"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"0"}]}]},{"title":"Day 28","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"1"},{"groupId":"OG001","value":"0"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"0"}]}]}]},{"type":"OTHER_PRE_SPECIFIED","title":"Need for Further Care as Determined by Medical Record Review as Mean Number of Visits in the System for Lyme Arthritis Symptoms During Each Time Frame","description":"Mean repeat medical visits for Lyme arthritis will be compared between treatment arms based on medical record review","populationDescription":"All patients were analyzed for return visits by: 30 days, 60 days, 120 days, 1 year","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"Full Range","unitOfMeasure":"return visits for Lyme arthritis symptom","timeFrame":"30 days, 60 days, 120 days, 1 year","groups":[{"id":"OG000","title":"NSAID","description":"Naproxen at weight based standard dose given bid daily until symptoms resolve"},{"id":"OG001","title":"Acetaminophen","description":"Acetaminophen at weight based standard dose given qid until symptoms resolve"},{"id":"OG002","title":"NSAID First, Then Acetaminophen","description":"Naproxen at weight based standard dose given bid for one week, then acetaminophen at weight based standard dose given qid until symptoms resolve"},{"id":"OG003","title":"Standard Care","description":"Symptom observation only"}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"1"},{"groupId":"OG001","value":"2"},{"groupId":"OG002","value":"0"},{"groupId":"OG003","value":"0"}]}],"classes":[{"title":"30 days","categories":[{"measurements":[{"groupId":"OG000","value":"0","lowerLimit":"0","upperLimit":"0"},{"groupId":"OG001","value":"0","lowerLimit":"0","upperLimit":"0"}]}]},{"title":"60 days","categories":[{"measurements":[{"groupId":"OG000","value":"0","lowerLimit":"0","upperLimit":"0"},{"groupId":"OG001","value":"0","lowerLimit":"0","upperLimit":"0"}]}]},{"title":"120 days","categories":[{"measurements":[{"groupId":"OG000","value":"0","lowerLimit":"0","upperLimit":"0"},{"groupId":"OG001","value":"0","lowerLimit":"0","upperLimit":"0"}]}]},{"title":"1 year","categories":[{"measurements":[{"groupId":"OG000","value":"0","lowerLimit":"0","upperLimit":"0"},{"groupId":"OG001","value":"0","lowerLimit":"0","upperLimit":"0"}]}]}]}]},"adverseEventsModule":{"frequencyThreshold":"0","timeFrame":"Collected by text surveys at days from enrollment: 0, 1, 3, 7, 10, 14, 21, 28, 60 until asymptomatic.","description":"Collected by text surveys at days from enrollment: 0, 1, 3, 7, 10, 14, 21, 28, 60. Question: Have you noticed any medication side-effects.","eventGroups":[{"id":"EG000","title":"NSAID","description":"Naproxen at weight based standard dose given bid daily until symptoms resolve\n\nNaproxen: Patients will be randomized to an NSAID (naproxen)","deathsNumAffected":0,"deathsNumAtRisk":1,"seriousNumAffected":0,"seriousNumAtRisk":1,"otherNumAffected":1,"otherNumAtRisk":1},{"id":"EG001","title":"Acetaminophen","description":"Acetaminophen at weight based standard dose given qid until symptoms resolve\n\nAcetaminophen: Patients will be randomized to acetaminophen","deathsNumAffected":0,"deathsNumAtRisk":2,"seriousNumAffected":0,"seriousNumAtRisk":2,"otherNumAffected":0,"otherNumAtRisk":2},{"id":"EG002","title":"NSAID First, Then Acetaminophen","description":"Naproxen at weight based standard dose given bid for one week, then acetaminophen at weight based standard dose given qid until symptoms resolve\n\nNaproxen: Patients will be randomized to an NSAID (naproxen)\n\nAcetaminophen: Patients will be randomized to acetaminophen","deathsNumAffected":0,"deathsNumAtRisk":0,"seriousNumAffected":0,"seriousNumAtRisk":0,"otherNumAffected":0,"otherNumAtRisk":0},{"id":"EG003","title":"Standard Care","description":"Symptom observation only","deathsNumAffected":0,"deathsNumAtRisk":0,"seriousNumAffected":0,"seriousNumAtRisk":0,"otherNumAffected":0,"otherNumAtRisk":0}],"otherEvents":[{"term":"Emesis","organSystem":"Gastrointestinal disorders","assessmentType":"SYSTEMATIC_ASSESSMENT","notes":"one episode of emesis reported on day 7 survey","stats":[{"groupId":"EG000","numEvents":1,"numAffected":1,"numAtRisk":1},{"groupId":"EG001","numEvents":0,"numAffected":0,"numAtRisk":2},{"groupId":"EG002","numEvents":0,"numAffected"