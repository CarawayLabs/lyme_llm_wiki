{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carawaylabs.example/schemas/topx-lyme-search-result-page.schema.json",
  "title": "TOPx Lyme Data Exploration Search Result Page",
  "description": "A source-preserving envelope for one executed search request and its normalized records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "query",
    "source",
    "response",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "response": {
      "$ref": "#/$defs/response"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "status",
        "software"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}_\\d{2}-\\d{2}-\\d{2}_M[DS]T$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "partial",
            "failed"
          ]
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "git_commit": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search_id",
        "query_mode",
        "method",
        "endpoint",
        "search_term",
        "parameters",
        "auth"
      ],
      "properties": {
        "search_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[0-9]{4}$"
        },
        "query_mode": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "HEAD"
          ]
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "search_term": {
          "type": "string"
        },
        "search_expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "request_body": {
          "type": [
            "object",
            "array",
            "string",
            "null"
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement",
            "credential_alias",
            "credential_sent"
          ],
          "properties": {
            "requirement": {
              "enum": [
                "required",
                "optional_recommended",
                "none",
                "account_or_license_may_be_required"
              ]
            },
            "credential_alias": {
              "type": [
                "string",
                "null"
              ]
            },
            "credential_sent": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_name",
        "catalog_slug",
        "source_type",
        "organization",
        "docs_url"
      ],
      "properties": {
        "catalog_name": {
          "type": "string"
        },
        "catalog_slug": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "docs_url": {
          "type": "string",
          "format": "uri"
        },
        "license_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "terms_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "data_use_restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieved_at",
        "http_status",
        "content_type",
        "duration_ms",
        "page",
        "record_count"
      ],
      "properties": {
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page_number",
            "has_more"
          ],
          "properties": {
            "page_number": {
              "type": "integer",
              "minimum": 1
            },
            "page_size": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cursor_in": {
              "type": [
                "string",
                "null"
              ]
            },
            "cursor_out": {
              "type": [
                "string",
                "null"
              ]
            },
            "offset": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "has_more": {
              "type": "boolean"
            }
          }
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rate_limit": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ]
            },
            "remaining": {
              "type": [
                "integer",
                "null"
              ]
            },
            "reset_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "raw_file": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_id",
        "source_record_id",
        "record_type",
        "title",
        "source_url",
        "retrieved_at",
        "identifiers",
        "access",
        "provenance",
        "raw_metadata"
      ],
      "properties": {
        "normalized_id": {
          "type": "string"
        },
        "source_record_id": {
          "type": "string"
        },
        "record_type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "modified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "issued_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "organizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/organization"
          }
        },
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          }
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "properties": {
            "doi": {
              "type": [
                "string",
                "null"
              ]
            },
            "pmid": {
              "type": [
                "string",
                "null"
              ]
            },
            "pmcid": {
              "type": [
                "string",
                "null"
              ]
            },
            "nct_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "project_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "npi": {
              "type": [
                "string",
                "null"
              ]
            },
            "rxcui": {
              "type": [
                "string",
                "null"
              ]
            },
            "county_fips": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{5}$"
            },
            "tract_geoid": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "pathogens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "vectors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "interventions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "medications": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "geographies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/geography"
          }
        },
        "temporal_coverage": {
          "$ref": "#/$defs/temporal"
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "distributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/distribution"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "data_quality": {
          "$ref": "#/$defs/data_quality"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "raw_metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "orcid": {
          "type": [
            "string",
            "null"
          ]
        },
        "affiliation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "name"
      ],
      "properties": {
        "level": {
          "enum": [
            "national",
            "region",
            "state",
            "county",
            "tract",
            "block_group",
            "zcta",
            "point",
            "other"
          ]
        },
        "name": {
          "type": "string"
        },
        "state_fips": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{2}$"
        },
        "county_fips": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{5}$"
        },
        "geoid": {
          "type": [
            "string",
            "null"
          ]
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "geometry": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    },
    "temporal": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "end_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "years": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 2200
          }
        },
        "vintage": {
          "type": [
            "string",
            "null"
          ]
        },
        "update_frequency": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_level",
        "machine_readable"
      ],
      "properties": {
        "access_level": {
          "enum": [
            "public",
            "restricted_public",
            "non_public",
            "unknown"
          ]
        },
        "machine_readable": {
          "type": "boolean"
        },
        "api_available": {
          "type": "boolean"
        },
        "download_available": {
          "type": "boolean"
        },
        "requires_account": {
          "type": "boolean"
        },
        "requires_license": {
          "type": "boolean"
        },
        "cost": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "rights_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "format"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "format": {
          "type": "string"
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "byte_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_type",
        "target_identifier"
      ],
      "properties": {
        "relationship_type": {
          "type": "string"
        },
        "target_identifier": {
          "type": "string"
        },
        "target_record_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "data_quality": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "completeness_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "freshness_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "has_documentation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "has_data_dictionary": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "known_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suppression_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manual_review_required": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_catalog",
        "search_id",
        "normalization_version"
      ],
      "properties": {
        "source_catalog": {
          "type": "string"
        },
        "search_id": {
          "type": "string"
        },
        "normalization_version": {
          "type": "string"
        },
        "source_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_row_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retrieval_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "raw_file_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_record_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_type",
        "message",
        "retryable"
      ],
      "properties": {
        "error_type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "details": {
          "type": [
            "object",
            "string",
            "null"
          ],
          "additionalProperties": true
        }
      }
    }
  }
}
